# ==============================================================================
# Jev Judge — Backend Configuration
# ==============================================================================

# Option 1: OpenRouter Jev (Direct access to Jev model WITHOUT waitlist!)
# Get an instant key from: https://openrouter.ai/keys
# Uses model '~typesafe/jev-latest' via OpenRouter Decisions API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: Official TypeSafe AI (Gated waitlist)
# TYPESAFE_API_KEY=your_typesafe_key_here

# Option 3: Groq (Ultra-fast ~150ms Llama 3.3 70B, free tier available)
# Get a free key from: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# Option 4: OpenAI (GPT-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# Option 5: Local Demo Mock Mode
# If no API keys are configured, the backend automatically runs in Local Demo Mode
# with intelligent offline classification — perfect for testing without any keys!

PORT=8787
DEBUG=true
